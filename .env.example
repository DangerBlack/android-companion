# Copy to .env and customize.
# URL reachable by the phone (use the machine's LAN IP if the device is not localhost).
NTFY_BASE_URL=http://localhost:8080
NTFY_BEHIND_PROXY=false
# Message cache duration (replay for offline clients).
NTFY_CACHE_DURATION=12h
# Anonymous access: read-write for local dev; set deny-all and create a token for production.
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# --- Used by the MCP server and the app ---
# Secret topic: treat it like a password (generate a long random string).
NTFY_TOPIC=companion-CHANGE-ME-to-a-long-random-string
# ntfy token (empty in dev without auth): tk_xxxxxxxx
NTFY_TOKEN=
