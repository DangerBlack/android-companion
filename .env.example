# Copia in .env e personalizza.
# URL raggiungibile dal telefono (IP LAN della macchina se il device non e' localhost).
NTFY_BASE_URL=http://localhost:8080
NTFY_BEHIND_PROXY=false
# Durata cache messaggi (replay per client offline).
NTFY_CACHE_DURATION=12h
# Accesso anonimo: read-write per dev locale; metti deny-all e crea token per la produzione.
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# --- Usati dal server MCP e dall'app ---
# Topic segreto: trattalo come una password (genera una stringa casuale lunga).
NTFY_TOPIC=companion-CHANGE-ME-to-a-long-random-string
# Token ntfy (vuoto in dev senza auth): tk_xxxxxxxx
NTFY_TOKEN=
