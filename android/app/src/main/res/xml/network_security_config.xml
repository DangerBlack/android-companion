<?xml version="1.0" encoding="utf-8"?>
<!--
  Hardening: HTTPS obbligatorio di default; cleartext consentito SOLO per host locali
  di sviluppo (adb reverse / emulatore). Per l'uso wireless su IP LAN, esegui ntfy
  dietro un reverse proxy TLS, oppure aggiungi qui il tuo host/IP di fiducia.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
