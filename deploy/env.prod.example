# Copy to .env on the server and fill in.

# Public hostname served by Caddy (automatic TLS via Let's Encrypt).
DOMAIN=companion.example.com

# Image to run (build & push your own, or use the official ntfy if you prefer).
RELAY_IMAGE=dangerblack/android-companion-relay:latest

# ntfy
NTFY_BASE_URL=https://companion.example.com
NTFY_BEHIND_PROXY=true
NTFY_CACHE_DURATION=12h
NTFY_AUTH_DEFAULT_ACCESS=deny-all

# Bootstrap admin user (created on first start if missing).
NTFY_USER=companion
NTFY_PASSWORD=change-me-to-a-strong-password
NTFY_USER_ROLE=admin

# Secret topic shared by the MCP publisher and the Android app.
NTFY_TOPIC=companion-CHANGE-ME-to-a-long-random-string

TZ=UTC
